  <!-- HERO -->
  <section class="hero">
    <div class="hero-waves">
      <svg viewBox="0 0 1440 800" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,400 Q180,360 360,400 Q540,440 720,400 Q900,360 1080,400 Q1260,440 1440,400" stroke="white" stroke-width="1.5" fill="none"/>
