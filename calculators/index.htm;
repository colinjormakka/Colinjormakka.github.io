  </section>

  <!-- TOOLS SECTION -->
  <section class="tools-section" id="calculators">
    <div class="section-eyebrow">Tools</div>
    <h2 class="section-title">Every calculator<br />you actually need.</h2>
    <p class="section-sub">Built with Canadian tax rules, contribution limits, and regulations in mind. Updated annually.</p>

    <div class="tools-grid">

      <a href="calculators/tfsa.html" class="tool-card">
        <div class="tool-icon">
